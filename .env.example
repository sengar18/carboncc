# ==============================================================================
# CARBONSCOUT INDIA — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Provider selection. Use mock values for local zero-credit tests; production uses Groq, Firecrawl, and Supabase.
AI_PROVIDER=mock
RESEARCH_PROVIDER=mock
DATABASE_PROVIDER=mock_memory

# Supabase Configuration (Optional in mock mode; required for live PostgreSQL)
# Client-accessible variables:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only variable (NEVER expose to client):
SUPABASE_SERVICE_ROLE_KEY=

# Firecrawl Integration (Server-only key for live corporate web research)
FIRECRAWL_API_KEY=

# Groq AI integration (server-only)
GROQ_API_KEY=

# Administrator-only CRM access (server-only; never use a NEXT_PUBLIC_ prefix)
ADMIN_SECRET_KEY=

# Storage Configuration
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_FILE_TYPES=application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document
